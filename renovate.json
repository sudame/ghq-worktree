{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": [
    "before 9am"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "メジャー以外は 1 つの PR にまとめ、CI が通ったら自動でマージする。出たばかりの版は避ける。ブランチ名は日本語から作れないので groupSlug を書く",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin"
      ],
      "groupName": "メジャー以外の更新",
      "groupSlug": "non-major",
      "automerge": true,
      "minimumReleaseAge": "3 days"
    }
  ]
}
