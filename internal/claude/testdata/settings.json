{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh api *)"
    ],
    "deny": [],
    "additionalDirectories": [
      "/home/user/worktrees"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/bin/bash-guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/user/.claude/hooks/stop.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "language": "日本語",
  "effortLevel": "medium"
}
